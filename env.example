# Copy to .env and fill in. Values are read through Effect's Config at startup,
# so a missing one fails immediately with a readable error rather than at first use.

# Port 5433, not 5432 — the container is published there to avoid colliding with a
# Postgres already running on this machine.
DATABASE_URL=postgres://music:music@localhost:5433/music

# https://freqblog.com — free tier is 1,000 requests/month, key arrives by email.
FREQBLOG_API_KEY=

# `live` (default) or `mock`. `mock` swaps the transport for a seeded in-process
# catalogue — same adapter, same decoding, no key and no quota. Use it for local
# development and for anything that would otherwise burn the monthly allowance.
FREQBLOG_MODE=live

# Optional, mock only: return 429 after this many requests, so the QuotaExceeded path
# can be exercised without waiting for a real allowance to run out. Unset = unlimited.
# FREQBLOG_MOCK_QUOTA=50

# No key is needed for vocal-vs-instrumental detection. LRCLIB (https://lrclib.net) is
# free, needs no auth, and returns an explicit `instrumental` flag. Musixmatch was the
# original plan at $50/month and was dropped; FreqBlog's own lyrics endpoint serves the
# same LRCLIB data but spends a request, and its `instrumentalness` field is flagged
# unreliable by its own operator.
