# Copy to .env and fill in. Values are read through Effect's Config at startup,
# so a missing one fails immediately with a readable error rather than at first use.

# Port 5433, not 5432 — the container is published there to avoid colliding with a
# Postgres already running on this machine.
DATABASE_URL=postgres://music:music@localhost:5433/music

# https://freqblog.com — free tier is 1,000 requests/month, key arrives by email.
FREQBLOG_API_KEY=

# Primary signal for vocal vs instrumental. Free developer tier.
# Deliberately NOT taken from FreqBlog, whose instrumentalness field is flagged unreliable.
MUSIXMATCH_API_KEY=
