{
  "name": "music-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
